{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/icon.svg", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "catalog",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": { "files": ["/images/**", "/media/**"] }
    }
  ],
  "dataGroups": [
    {
      "name": "public-catalog",
      "version": 1,
      "urls": ["/data/catalog.json"],
      "cacheConfig": { "strategy": "freshness", "maxSize": 1, "maxAge": "30d", "timeout": "5s" },
      "cacheQueryOptions": { "ignoreSearch": true }
    }
  ]
}
